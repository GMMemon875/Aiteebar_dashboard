# FastAPI / PostgreSQL Configuration (Placeholders Only - Never Commit Real Secrets)
APP_ENV=development
DATABASE_URL=postgresql+psycopg://aiteebar_user:CHANGE_ME_DB_PASSWORD@localhost:5432/aiteebar_db

# JWT Signing Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_48_BYTE_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Restricted CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_ENROLL_PER_MINUTE=10
RATE_LIMIT_SCANS_PER_MINUTE=60

# Initial Bootstrap Admin (used by seed script only)
BOOTSTRAP_ADMIN_EMAIL=admin@company.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=Security Administrator

# Scanner Baseline Version
RECOMMENDED_SCANNER_VERSION=1.4.2
